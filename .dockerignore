# Docker build context exclusions: source only.

# Build artefacts
target/
**/target/

# VCS + history
.git/
.gitignore

# Docs. The root README and licence stay, because Cargo.toml names them.
docs/

# Local secrets -- never let these land in a builder layer
.env
.env.*

# Benches + local dev / agent artefacts
benches/
.claude/
.codex/
.cursor/
.gemini/
.mcp.json
.ai-version

# Editor / OS noise
.vscode/
.idea/
**/*.swp
.DS_Store
